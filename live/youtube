<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Stream</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #0f0f0f;
      color: #fff;
    }

    /* Header */
    header {
      height: 64px;
      background: #0f0f0f;
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 20px;
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid #222;
    }

    .menu {
      font-size: 25px;
      cursor: pointer;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 21px;
      font-weight: bold;
      white-space: nowrap;
    }

    .youtube-icon {
      background: #ff0000;
      width: 34px;
      height: 24px;
      border-radius: 7px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .youtube-icon::after {
      content: "";
      border-left: 9px solid white;
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
    }

    .search {
      flex: 1;
      max-width: 650px;
      margin: auto;
      display: flex;
    }

    .search input {
      width: 100%;
      background: #121212;
      border: 1px solid #303030;
      padding: 12px 18px;
      border-radius: 25px 0 0 25px;
      color: white;
      font-size: 16px;
      outline: none;
    }

    .search button {
      width: 65px;
      border: 1px solid #303030;
      background: #222;
      color: white;
      border-radius: 0 25px 25px 0;
      font-size: 20px;
      cursor: pointer;
    }

    .right-icons {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 22px;
    }

    .profile {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #673ab7;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    /* Main */
    .container {
      max-width: 1500px;
      margin: 25px auto;
      padding: 0 25px;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 25px;
    }

    /* Video */
    .video-wrapper {
      position: relative;
      background: #000;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 10px;
      overflow: hidden;
    }

    .video-wrapper iframe {
      width: 100%;
      height: 100%;
      border: none;
    }

    .live-badge {
      position: absolute;
      top: 15px;
      left: 15px;
      background: #ff0000;
      padding: 7px 12px;
      border-radius: 5px;
      font-size: 13px;
      font-weight: bold;
      z-index: 2;
    }

    /* Title */
    .title {
      font-size: 23px;
      font-weight: 600;
      margin-top: 18px;
      margin-bottom: 15px;
    }

    .channel {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    .channel-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: #e91e63;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    .channel-name {
      font-weight: bold;
    }

    .subscribers {
      color: #aaa;
      font-size: 13px;
      margin-top: 4px;
    }

    .subscribe {
      background: #fff;
      color: #000;
      border: none;
      padding: 11px 18px;
      border-radius: 22px;
      font-weight: bold;
      cursor: pointer;
    }

    /* Buttons */
    .actions {
      display: flex;
      gap: 10px;
      margin: 18px 0;
      flex-wrap: wrap;
    }

    .action {
      background: #272727;
      border: none;
      color: white;
      padding: 10px 17px;
      border-radius: 22px;
      cursor: pointer;
      font-size: 14px;
    }

    .action:hover {
      background: #3a3a3a;
    }

    /* Description */
    .description {
      background: #272727;
      border-radius: 10px;
      padding: 16px;
      line-height: 1.6;
      color: #ddd;
      margin-bottom: 25px;
    }

    .description strong {
      color: white;
    }

    /* Chat */
    .chat {
      border: 1px solid #303030;
      border-radius: 10px;
      height: 650px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .chat-header {
      padding: 16px;
      border-bottom: 1px solid #303030;
      font-weight: bold;
      font-size: 17px;
    }

    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 15px;
    }

    .message {
      margin-bottom: 18px;
      display: flex;
      gap: 10px;
    }

    .message-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #444;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      flex-shrink: 0;
    }

    .message-name {
      color: #aaa;
      font-size: 12px;
      margin-bottom: 3px;
    }

    .message-text {
      font-size: 14px;
    }

    .chat-input {
      border-top: 1px solid #303030;
      padding: 12px;
      display: flex;
      gap: 8px;
    }

    .chat-input input {
      flex: 1;
      background: #181818;
      border: 1px solid #444;
      border-radius: 20px;
      padding: 10px 15px;
      color: white;
      outline: none;
    }

    .chat-input button {
      background: #ff0000;
      color: white;
      border: none;
      padding: 0 16px;
      border-radius: 20px;
      cursor: pointer;
    }

    /* Mobile */
    @media (max-width: 900px) {
      header {
        padding: 0 12px;
        gap: 12px;
      }

      .search {
        display: none;
      }

      .right-icons {
        margin-left: auto;
      }

      .layout {
        grid-template-columns: 1fr;
      }

      .chat {
        display: none;
      }

      .container {
        margin-top: 10px;
        padding: 0;
      }

      .video-wrapper {
        border-radius: 0;
      }

      .title,
      .channel,
      .actions,
      .description {
        margin-left: 15px;
        margin-right: 15px;
      }

      .title {
        font-size: 19px;
      }
    }
  </style>
</head>

<body>

  <!-- Header -->
  <header>

    <div class="menu">☰</div>

    <div class="logo">
      <div class="youtube-icon"></div>
      <span>YouTube</span>
    </div>

    <div class="search">
      <input type="text" placeholder="Search">
      <button>🔍</button>
    </div>

    <div class="right-icons">
      <span>📹</span>
      <span>🔔</span>
      <div class="profile">N</div>
    </div>

  </header>


  <!-- Main -->
  <div class="container">

    <div class="layout">

      <!-- Left -->
      <main>

        <!-- Live Video -->
        <div class="video-wrapper">

          <div class="live-badge">
            🔴 LIVE
          </div>

          <iframe
            src="https://www.youtube.com/embed/AE2qSGXVb38?autoplay=1&mute=0&rel=0"
            title="Live Stream"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen>
          </iframe>

        </div>


        <!-- Title -->
        <div class="title">
          🔴 Live Stream
        </div>


        <!-- Channel -->
        <div class="channel">

          <div class="channel-info">

            <div class="avatar">
              N
            </div>

            <div>
              <div class="channel-name">
                Noor Mohammed Yaseeni
              </div>

              <div class="subscribers">
                Live Streaming Channel
              </div>
            </div>

          </div>

          <button class="subscribe" onclick="subscribe()">
            Subscribe
          </button>

        </div>


        <!-- Actions -->
        <div class="actions">

          <button class="action" onclick="likeVideo()">
            👍 Like <span id="likeCount">0</span>
          </button>

          <button class="action" onclick="shareVideo()">
            ↗ Share
          </button>

          <button class="action">
            💾 Save
          </button>

        </div>


        <!-- Description -->
        <div class="description">

          <strong>🔴 LIVE NOW</strong>
          <br><br>

          Welcome to the live stream.
          Watch the live broadcast here in high quality.

          <br><br>

          Please like, share and subscribe for more live updates.

        </div>

      </main>


      <!-- Live Chat -->
      <aside>

        <div class="chat">

          <div class="chat-header">
            Live Chat
          </div>

          <div class="messages" id="messages">

            <div class="message">
              <div class="message-avatar">A</div>
              <div>
                <div class="message-name">Ahmed</div>
                <div class="message-text">
                  Assalamu Alaikum ❤️
                </div>
              </div>
            </div>

            <div class="message">
              <div class="message-avatar">M</div>
              <div>
                <div class="message-name">Mohamed</div>
                <div class="message-text">
                  MashaAllah 🤲
                </div>
              </div>
            </div>

            <div class="message">
              <div class="message-avatar">N</div>
              <div>
                <div class="message-name">Naseer</div>
                <div class="message-text">
                  Beautiful live stream ❤️
                </div>
              </div>
            </div>

          </div>


          <div class="chat-input">

            <input
              type="text"
              id="chatMessage"
              placeholder="Say something..."
              onkeydown="if(event.key==='Enter') sendMessage()"
            >

            <button onclick="sendMessage()">
              Send
            </button>

          </div>

        </div>

      </aside>

    </div>

  </div>


  <script>

    let likes = 0;

    function likeVideo() {

      likes++;

      document.getElementById("likeCount").innerText = likes;

    }


    function subscribe() {

      const button = document.querySelector(".subscribe");

      if (button.innerText === "Subscribe") {

        button.innerText = "Subscribed";
        button.style.background = "#272727";
        button.style.color = "#fff";

      } else {

        button.innerText = "Subscribe";
        button.style.background = "#fff";
        button.style.color = "#000";

      }

    }


    function shareVideo() {

      const url = window.location.href;

      if (navigator.share) {

        navigator.share({
          title: "Live Stream",
          text: "Watch this live stream",
          url: url
        });

      } else {

        navigator.clipboard.writeText(url);

        alert("Link copied!");

      }

    }


    function sendMessage() {

      const input = document.getElementById("chatMessage");
      const text = input.value.trim();

      if (text === "") return;

      const message = document.createElement("div");

      message.className = "message";

      message.innerHTML = `
        <div class="message-avatar">N</div>
        <div>
          <div class="message-name">You</div>
          <div class="message-text">${text}</div>
        </div>
      `;

      document.getElementById("messages").appendChild(message);

      input.value = "";

      const messages = document.getElementById("messages");

      messages.scrollTop = messages.scrollHeight;

    }

  </script>

</body>
</html>